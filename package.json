{
  "name": "jarvis-harness",
  "version": "0.0.1",
  "description": "Jarvis — durable AI engineering runtime: spec-driven workflows, project knowledge, context policies, resource governance, replaceable LLMs.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.0",
  "bin": {
    "jarvis": "./bin/jarvis.js"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "node src/cli/main.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "commander": "^15.0.0",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
